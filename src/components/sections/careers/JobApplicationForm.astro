---
import Button from "@/components/ui/buttons/Button.astro";

interface Props {
  jobTitle: string;
  location: string;
}

const { jobTitle, location } = Astro.props;
const formId = `apply-form-${jobTitle.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
---

<form
  class="space-y-6"
  id={formId}
  name="job-application"
  method="POST"
  enctype="multipart/form-data"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  data-job-title={jobTitle}
  data-job-location={location}
>
  <input type="hidden" name="form-name" value="job-application" />
  <input type="hidden" name="bot-field" class="hidden" />
  <input type="hidden" name="job-title" value={jobTitle} />
  <input type="hidden" name="job-location" value={location} />

  <!-- Success / Error Message -->
  <div class="form-message hidden"></div>

  <!-- Name & Phone -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="space-y-2">
      <label class="text-sm md:text-base font-grotesk font-medium uppercase text-muted">
        Full Name *
      </label>
      <input
        type="text"
        name="name"
        required
        placeholder="Your full name"
        class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-secondary outline-none transition-colors duration-300 placeholder:text-muted/50"
      />
    </div>
    <div class="space-y-2">
      <label class="text-sm md:text-base font-grotesk font-medium uppercase text-muted">
        Mobile Number *
      </label>
      <input
        type="tel"
        name="mobile"
        required
        placeholder="+91 98765 43210"
        class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-secondary outline-none transition-colors duration-300 placeholder:text-muted/50"
      />
    </div>
  </div>

  <!-- Email -->
  <div class="space-y-2">
    <label class="text-sm md:text-base font-grotesk font-medium uppercase text-muted">
      Email *
    </label>
    <input
      type="email"
      name="email"
      required
      placeholder="example@email.com"
      class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-secondary outline-none transition-colors duration-300 placeholder:text-muted/50"
    />
  </div>

  <!-- Resume Upload -->
  <div class="space-y-2">
    <label class="text-sm md:text-base font-grotesk font-medium uppercase text-muted">
      Resume (PDF/DOC) *
    </label>
    <input
      type="file"
      name="resume"
      required
      accept=".pdf,.doc,.docx"
      class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-secondary outline-none transition-colors duration-300 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-secondary file:text-foreground file:font-semibold file:cursor-pointer"
    />
  </div>

  <!-- Message -->
  <div class="space-y-2">
    <label class="text-sm md:text-base font-grotesk font-medium uppercase text-muted">
      Message (optional)
    </label>
    <textarea
      name="message"
      rows="4"
      placeholder="Anything you'd like us to know..."
      class="w-full px-4 py-3 bg-transparent border-b-2 border-muted focus:border-secondary outline-none transition-colors duration-300 placeholder:text-muted/50 resize-none"
    ></textarea>
  </div>

  <!-- Submit Button -->
  <Button variant="solid" size="md" class="apply-submit-btn w-full md:w-auto px-12" id={`${formId}-submit`}>
    <span class="btn-text">Submit Application</span>
    <span class="btn-loader hidden">
      <svg class="animate-spin h-5 w-5 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Submitting...
    </span>
  </Button>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('form[name="job-application"]');

  forms.forEach((form) => {
    const submitBtn = form.querySelector<HTMLButtonElement>(".apply-submit-btn");
    const btnText = form.querySelector(".btn-text");
    const btnLoader = form.querySelector(".btn-loader");
    const formMessage = form.querySelector(".form-message");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (formMessage) {
        formMessage.classList.add("hidden");
        formMessage.innerHTML = "";
      }

      if (submitBtn && btnText && btnLoader) {
        submitBtn.disabled = true;
        btnText.classList.add("hidden");
        btnLoader.classList.remove("hidden");
      }

      try {
        const formData = new FormData(form);
        const response = await fetch(window.location.pathname, {
          method: "POST",
          body: formData,
        });

        if (response.ok) {
          if (formMessage) {
            formMessage.classList.remove("hidden");
            formMessage.className = "form-message p-4 bg-green-100 border-2 border-green-500 rounded-xl text-green-800";
            formMessage.innerHTML = '<p class="font-semibold">✓ Application submitted! We\'ll be in touch soon.</p>';
          }
          form.reset();
          formMessage?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          throw new Error("Submission failed");
        }
      } catch {
        if (formMessage) {
          formMessage.classList.remove("hidden");
          formMessage.className = "form-message p-4 bg-red-100 border-2 border-red-500 rounded-xl text-red-800";
          formMessage.innerHTML = '<p class="font-semibold">✗ Something went wrong. Please try again or email us directly.</p>';
        }
      } finally {
        if (submitBtn && btnText && btnLoader) {
          submitBtn.disabled = false;
          btnText.classList.remove("hidden");
          btnLoader.classList.add("hidden");
        }
      }
    });
  });
</script>
